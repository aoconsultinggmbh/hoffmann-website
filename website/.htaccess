# Praxis Dr. Hoffmann – Apache-Konfiguration (All-Inkl / IONOS)
Options -Indexes
AddDefaultCharset UTF-8
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- Uebergangsadresse des Hosters nicht umleiten -------------------------
  # Vor dem Domain-Umzug ist die Seite nur unter der Adresse
  # <domain>.<konto>.kasserver.com erreichbar. Ohne diese Ausnahme wuerde die
  # Umleitung darunter jeden Aufruf sofort wieder auf die ALTE Seite schicken,
  # und der Test vor dem Livegang waere unmoeglich.
  # Die Regel bleibt auch nach dem Livegang stehen: sie stoert nicht und
  # rettet den naechsten Test.
  RewriteCond %{HTTP_HOST} \.kasserver\.com$ [NC]
  RewriteRule ^ - [L]
  # HTTPS erzwingen und www auf die Hauptdomain leiten
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^(.*)$ https://gyn-rangsdorf.de/$1 [L,R=301]
  # Alte URLs der bisherigen Seite und des WordPress-Entwurfs
  RewriteRule ^gynaekologie/?$ /frauenheilkunde/ [R=301,L]
  RewriteRule ^gynaekologie/(.*)$ /frauenheilkunde/$1 [R=301,L]
  RewriteRule ^aesthetische-medizin/?$ /aesthetik/ [R=301,L]
  RewriteRule ^ueber-uns/?$ /praxis/ [R=301,L]
  RewriteRule ^hinweis-sprache/?$ /gleichstellung/ [R=301,L]
  RewriteRule ^startseite/?$ / [R=301,L]
  # Ordner ohne abschließenden Slash auf Slash-Variante
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.+[^/])$ /$1/ [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  <FilesMatch "\.(css|js|woff2|webp|jpg|png|svg|mp4|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=600, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType video/mp4 .mp4
  AddType text/vtt .vtt
</IfModule>
